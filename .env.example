# MongoDB Atlas (free M0 tier is enough for this site)
MONGODB_URI="mongodb+srv://admin:admin@cluster0.v3bj3xy.mongodb.net/?appName=Cluster0"
MONGODB_DB="taal"

# Admin area — any long random string; used by /admin and the write APIs
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Cloudflare R2 (only needed once staff upload PDF forms themselves;
# until then keep forms in /public/forms and leave these blank)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="taal-forms"
R2_PUBLIC_BASE=""   # e.g. https://pub-xxxxxxxx.r2.dev
